# Server Configuration
PORT=3000
NODE_ENV=development

# LLM Provider Configuration
# 1. Standard OpenAI (GPT-4o-mini / GPT-4o)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# (Optional: Compatible with any OpenAI-compatible provider):
# Groq:        OPENAI_BASE_URL=https://api.groq.com/openai/v1   OPENAI_MODEL=llama-3.1-70b-versatile
# Gemini:      OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  OPENAI_MODEL=gemini-1.5-flash
# Ollama:      OPENAI_BASE_URL=http://localhost:11434/v1       OPENAI_MODEL=llama3.1
# OpenRouter:  OPENAI_BASE_URL=https://openrouter.ai/api/v1    OPENAI_MODEL=openai/gpt-4o-mini

# Detailing Shop Settings
SHOP_NAME="Cedar Lane Auto Detailing"
SHOP_TIMEZONE="America/Los_Angeles"
SHOP_OPEN_HOUR=8
SHOP_CLOSE_HOUR=18

# Google Cloud Service Account Credentials
# (If left empty, system uses local persistent JSON store for zero-friction testing)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_SPREADSHEET_ID=

# Phase 2: Vapi Configuration
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

